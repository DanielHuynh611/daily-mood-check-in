[Unit]
Description=Daily mood check-in web application
After=network.target mysql.service
Requires=mysql.service

[Service]
Type=simple
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/daily-mood-check-in
Environment="PATH=/home/ubuntu/daily-mood-check-in/.venv/bin"
Environment="DAILY_ENV=production"
EnvironmentFile=/home/ubuntu/daily-mood-check-in/.env
UMask=0077
ExecStart=/home/ubuntu/daily-mood-check-in/.venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8000 --access-logfile - --error-logfile - fullstack:create_app()
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
