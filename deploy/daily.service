[Unit]
Description=Daily mood check-in web application
After=network.target mysql.service
Requires=mysql.service

[Service]
Type=simple
User=ubuntu
Group=www-data
WorkingDirectory=/opt/daily
Environment="PATH=/opt/daily/.venv/bin"
Environment="DAILY_ENV=production"
EnvironmentFile=/etc/daily.env
UMask=0077
ExecStart=/opt/daily/.venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8000 --access-logfile - --error-logfile - fullstack:create_app()
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
